@databaseUrl = https://frank-gp-default-rtdb.firebaseio.com
@idToken = {{$dotenv ID_TOKEN}}

#################################
# GET
#################################

###
# Get all todos
GET {{databaseUrl}}/todos.json?auth={{idToken}}

###
# Get todo1
GET {{databaseUrl}}/todos/todo1.json?auth={{idToken}}


#################################
# POST
#################################

###
# Create todo with auto-generated id
POST {{databaseUrl}}/todos.json?auth={{idToken}}
Content-Type: application/json

{
  "title": "Read a book",
  "completed": false
}


#################################
# PUT
#################################

###
# Create/replace todo1
PUT {{databaseUrl}}/todos/todo1.json?auth={{idToken}}
Content-Type: application/json

{
  "title": "Learn English",
  "completed": false
}

###
# Create/replace todo2
PUT {{databaseUrl}}/todos/todo2.json?auth={{idToken}}
Content-Type: application/json

{
  "title": "Go to gym",
  "completed": false
}


#################################
# PATCH
#################################

###
# Mark todo1 as completed
PATCH {{databaseUrl}}/todos/todo1.json?auth={{idToken}}
Content-Type: application/json

{
  "completed": true
}

###
# Rename todo1
PATCH {{databaseUrl}}/todos/todo1.json?auth={{idToken}}
Content-Type: application/json

{
  "title": "Learn Flutter"
}

###
# Update multiple fields
PATCH {{databaseUrl}}/todos/todo1.json?auth={{idToken}}
Content-Type: application/json

{
  "title": "Learn Dart",
  "completed": false
}


#################################
# DELETE
#################################

###
# Delete todo1
DELETE {{databaseUrl}}/todos/todo1.json?auth={{idToken}}