@projectId = {{$dotenv FIREBASE_PROJECT_ID}}
@token = {{$dotenv TOKEN}}


###
# Create product
PATCH https://firestore.googleapis.com/v1/projects/{{projectId}}/databases/(default)/documents/products/rice
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fields": {
    "name": {
      "stringValue": "Rice"
    },
    "price": {
      "doubleValue": 10.5
    },
    "quantity": {
      "integerValue": "1"
    }
  }
}